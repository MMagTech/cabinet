<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store validation rejects a tvOS extension with a 64-bit
	     slice that does not declare arm64 here (error 90502). The host
	     app gets this from GENERATE_INFOPLIST_FILE, but this extension
	     supplies its own Info.plist and so has to say it itself. Found
	     on the first TestFlight upload that ever included the top
	     shelf; the archive builds and installs on hardware perfectly
	     well without it, so nothing but App Store submission catches
	     this. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSExtension</key>
	<dict>
		<!-- Taken from Xcode 26's own "TV Top Shelf Extension"
		     template, not from memory: the same point identifier serves
		     both the tvOS 9 era TVTopShelfProvider protocol and the
		     tvOS 13 TVTopShelfContentProvider class this extension
		     subclasses. Which API you get is decided by the principal
		     class below, not by a second identifier. -->
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.tv-top-shelf</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ContentProvider</string>
	</dict>
</dict>
</plist>
