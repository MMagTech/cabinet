<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Cabinet talks to a RomM server over HTTPS and does nothing else with
	     encryption, which is exempt. Same answer as the iOS target's
	     Info.plist. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- An Apple TV never leaves the house, so setting one up against the
	     server's address on the local network is a perfectly ordinary
	     choice, and that address is almost always plain http: no reverse
	     proxy, and no certificate anyone could issue for 192.168.1.10.
	     Without this, App Transport Security refuses those requests before
	     they leave the device, so a TV set up that way would fail at
	     pairing with nothing on screen explaining why. Local addresses
	     only; anything with a real hostname still has to be https. Same
	     exemption the iOS target carries. -->
	<!-- The top shelf launches the app by opening a URL, so the app
	     needs a scheme to be opened with. Nothing else uses this today,
	     and it is deliberately not advertised anywhere: it carries a rom
	     id and nothing more, and TVDeepLinkHandler refuses anything it
	     does not recognise. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mmagtech.Cabinet.topshelf</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cabinet</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cabinet uses your local network to reach your RomM server directly, instead of going out to the internet and back.</string>
	<!-- The lab's controller-link probe (see Lab/NetProbe.swift): the TV
	     side scans for the phone's GATT service as a Bluetooth central.
	     DEBUG-only code path; the key rides along in release where it
	     never runs. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cabinet uses Bluetooth to measure the link between your iPhone and Apple TV for controller features.</string>
</dict>
</plist>
