<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. These two exist here, not
	     as INFOPLIST_KEY_ build settings, because UIFileSharingEnabled
	     has no such setting: set that way it silently vanishes from the
	     built product, which shipped a build whose Games folder never
	     appeared in the Files app. Both keys together are what expose
	     Documents (the kept games mirror) in Files. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Cabinet talks to a RomM server over HTTPS and does nothing else with
	     encryption, which is exempt. Declaring it here answers the export
	     compliance question once instead of on every upload to App Store
	     Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Without this, iOS reserves a controller's Guide/Home button for its
	     own accessory picker instead of delivering it to
	     GCExtendedGamepad.buttonHome, which is what GameControllerManager
	     binds to the overlay menu. -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<!-- The optional local server address is almost always plain http: RomM
	     running bare on a LAN has no reverse proxy and no certificate anyone
	     could issue for 192.168.1.50. Without this, App Transport Security
	     refuses those requests before they leave the device. This exception
	     covers local addresses only, so every request to a real hostname,
	     the public server address included, still has to be https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Shown in the permission prompt iOS raises the first time the app
	     talks to an address on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cabinet uses your local network to reach your RomM server directly when you are at home, instead of going out to the internet and back.</string>
	<!-- The lab's controller-link probe (see Lab/NetProbe.swift). Bonjour
	     browsing needs its service type declared here or iOS denies the
	     browse outright; the Bluetooth key covers the probe's GATT link.
	     Both are DEBUG-only code paths, but Info.plist has no DEBUG, so
	     the keys ride along in release where the code never runs. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_cabinet-probe._udp</string>
	</array>
	<!-- Tilt aiming for the rotary joystick cabinets, whose one hand did
	     both movement and aim: the phone itself becomes the twist. -->
	<key>NSMotionUsageDescription</key>
	<string>Cabinet uses motion to let you aim by tilting, for arcade games whose joystick also rotated.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cabinet uses Bluetooth to measure the link between your iPhone and Apple TV for controller features.</string>
</dict>
</plist>
